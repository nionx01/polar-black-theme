{
  "name": "polar-black-themes",
  "displayName": "Polar Black",
  "description": "A beautiful, comprehensive icon theme with custom file/folder icons and product UI icons for Visual Studio Code",
  "version": "0.0.5",
  "publisher": "nionx01",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "themes",
    "icons",
    "icon theme",
    "file icons",
    "folder icons",
    "product icons",
    "ui icons",
    "polar black",
    "black",
    "theme",
    "color",
    "vibrant",
    "dark",
    "light",
    "cherry blossom",
    "savanna",
    "green cactus",
    "smoke",
    "red",
    "polar black themes",
    "polar black theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Polar Black Default Color",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-color-theme.json"
      },
      {
        "label": "Polar Black Vibrant Color",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-vibrant-color-theme.json"
      },
      {
        "label": "Polar Black Ice Color",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-ice-color-theme.json"
      },
      {
        "label": "Polar Black Cherry Blossom",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-cherry-blossom-color-theme.json"
      },
      {
        "label": "Polar Black Light",
        "uiTheme": "vs",
        "path": "./themes/polar-black-light-color-theme.json"
      },
      {
        "label": "Polar Black Savanna",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-savanna-color-theme.json"
      },
      {
        "label": "Polar Black Green Cactus",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-green-cactus-color-theme.json"
      },
      {
        "label": "Polar Black Less Black Smoke",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-less-black-smoke-color-theme.json"
      },
      {
        "label": "Polar Black Red",
        "uiTheme": "vs-dark",
        "path": "./themes/polar-black-red-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "polar-black-icons-default",
        "label": "Polar Black Icons",
        "path": "./themes/polar_black_icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "polar-black-ui",
        "label": "Polar Black Product Icons",
        "path": "./themes/polar-black-product-icons.json"
      }
    ],
    "configuration": {
      "title": "Polar Black",
      "properties": {
        "polarBlack.colorHighlight.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable inline color highlighting for color values (hex, rgb, rgba, hsl, hsla)."
        }
      }
    }
  },
  "icon": "polar_black_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nionx01/polar-black-theme"
  },
  "bugs": {
    "url": "https://github.com/nionx01/polar-black-icons/issues"
  },
  "license": "MIT"
}
